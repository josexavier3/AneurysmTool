   }
   Add BC: outlet3 {
      Type: Neu
      Time dependence: RCR
      RCR values: ({{OUTLET3_RP}}, {{OUTLET3_C}}, {{OUTLET3_RD}})
   }
   Add BC: wall {
      Type: Dir
      Time dependence: Steady
      Value: 0.0
   }
}

