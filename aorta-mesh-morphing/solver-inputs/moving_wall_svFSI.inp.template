Add mesh: mesh {
   Mesh scale factor: {{MESH_SCALE_FACTOR}}
   Mesh file path: {{FLUID_VOLUME_MESH}}
   Add face: inlet { Face file path: {{INLET_FACE}} }
   Add face: outlet { Face file path: {{OUTLET_FACE}} }
