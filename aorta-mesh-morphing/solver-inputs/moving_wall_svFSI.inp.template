   Add face: outlet2 { Face file path: {{OUTLET2_FACE}} }
   Add face: outlet3 { Face file path: {{OUTLET3_FACE}} }
   Add face: wall { Face file path: {{WALL_FACE}} }
   Domain: 1
}

Add equation: FSI {
   Coupled: t
   Min iterations: 3
   Max iterations: 20
   Tolerance: 1e-4

   Domain: 1 {
      Equation: fluid
      Density: {{FLUID_DENSITY}}
      Viscosity: Constant {Value: {{DYNAMIC_VISCOSITY}}}
      Backflow stabilization coefficient: 0.4
   }

   LS type: GMRES {
      Preconditioner: Trilinos-ML
      Max iterations: 800
      Tolerance: 1e-5
      Krylov space dimension: 100
   }

   Initialize RCR from flow: t
   Add BC: inlet {
      Type: Dir
      Time dependence: General
      Temporal and spatial values file path: {{INLET_VELOCITY_FILE}}
      Impose flux: t
   }
   Add BC: outlet {
      Type: Neu
      Time dependence: RCR
      RCR values: ({{OUTLET_RP}}, {{OUTLET_C}}, {{OUTLET_RD}})
   }
   Add BC: outlet1 {
      Type: Neu
      Time dependence: RCR
      RCR values: ({{OUTLET1_RP}}, {{OUTLET1_C}}, {{OUTLET1_RD}})
   }
   Add BC: outlet2 {
